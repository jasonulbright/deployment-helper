<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Deployment Helper"
    Width="1920" Height="1032"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One template and one set of button styles for the window and for every dialog. The dialogs
                 take the styles from this file (Get-SharedStyleXaml in the start script), so each style exists
                 once. The colors come from SuiteCommon (Set-ButtonTheme) and from MahApps resources, never from
                 a literal here. Hover and pressed show the theme foreground as border color; the fill stays, so a blue button
                 stays blue and a dark one never turns black or white. The dialog buttons use SuiteAccentButtonTemplate and
                 SuiteNeutralButtonTemplate (SuiteCommon), which step the fill one shade in hover and pressed. The sidebar template changes no opacity, because an opacity below 1 washes the text out.
                 A disabled button shows MahApps.Brushes.Gray.MouseOver text and a Gray2 border (4.5:1 or more in both themes). -->
            <ControlTemplate x:Key="ThemedButtonTemplate" TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Name="Cp"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ThemedButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">

                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Setter Property="Template" Value="{StaticResource ThemedButtonTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkflowButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="8,2,8,2"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkflowButtonStyle}"/>

            <!-- The primary button: the accent blue with white text. Deploy, Create Deployments, Promote, OK and Save Template use it. -->
            <Style x:Key="DialogAccentButton" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Template" Value="{DynamicResource SuiteAccentButtonTemplate}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.AccentBase}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}"/>
                <Setter Property="MinWidth" Value="90"/><Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The one secondary style, for Cancel, Browse and every other button that is not primary: a gray fill,
                 the theme text color and a visible border. It has the size of the primary style. -->
            <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Template" Value="{DynamicResource SuiteNeutralButtonTemplate}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Setter Property="MinWidth" Value="90"/><Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- The secondary style at the height of a form row (28). Same colors, same template. -->
            <Style x:Key="InlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- Text boxes and combo boxes: the Gray2 border of every theme, and gray text when disabled so that a disabled
                 field looks dimmed. WCAG 1.4.3 exempts disabled controls from the 4.5:1 text rule. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Selected and highlighted items: white text on the accent blue, in both themes. -->
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Column headers keep the case of their text (Title Case, D-12). MahApps draws them in capitals by default. -->
            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>
            <!-- The one DataGrid style of the main window: compact rows (24 px) and a 26 px column header at 1080p. -->
            <Style x:Key="ViewDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
                <Setter Property="ColumnHeaderHeight" Value="26"/>
                <Setter Property="RowHeight" Value="24"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeaderStyle}"/>
            </Style>
            <Style x:Key="GridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Section header: Gray1 is the only theme-adaptive MahApps greyscale
                 brush. Gray2 is static #7F7F7F and fails WCAG AA. Section headers keep the SemiBold weight in both themes. -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}"/>
                <Setter Property="Margin" Value="12,16,0,6"/>
            </Style>

            <Style x:Key="FormLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <!-- Validation glyph: the color stays at ThemeForeground. State is carried by the
                 glyph shape alone (checkmark, ballot x, horizontal ellipsis), never by Foreground. -->
            <Style x:Key="CheckGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CheckLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- &#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550; -->
        <!-- LEFT SIDEBAR                            -->
        <!-- &#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550; -->
        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,0">
                    <TextBlock x:Name="txtAppTitle" Text="Deployment Helper" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               Margin="0,0,0,0"
                                               MinWidth="0"
                                               ToolTip="Switch between the dark theme and the light theme."/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>

                        <Button x:Name="btnApps"            Content="Apps"                   Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Deploy an application to a device collection."/>
                        <Button x:Name="btnPackages"        Content="Packages"               Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Deploy a package and program to a device collection."/>
                        <Button x:Name="btnTaskSequences"   Content="Task Sequences"         Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Deploy a task sequence to a device collection."/>
                        <Button x:Name="btnSUG"             Content="Software Update Groups" Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Deploy a software update group to a device collection."/>
                        <Button x:Name="btnRings"           Content="Ring Deployment"        Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Deploy one object to several device collections in rings."/>
                        <Button x:Name="btnRollout"         Content="Update Rollout"         Style="{StaticResource WorkflowButtonStyle}"
                                ToolTip="Update applications: collections of devices below the new version, then deployments."/>

                        <Button x:Name="btnOptions"         Content="Options"                Style="{StaticResource OptionsButtonStyle}"
                                Margin="8,16,8,2"
                                ToolTip="Set the connection, the logs, the history and the templates."/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Sidebar / content separator -->
        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <!-- &#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550; -->
        <!-- MAIN CONTENT AREA                       -->
        <!-- &#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550; -->
        <Grid x:Name="contentGrid" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- The view takes its own height (Auto) and the log pane takes the rest of the free height. The start script
                     sets MaxHeight of this row from the window height, so that a small window scrolls the view instead of clipping. -->
                <RowDefinition x:Name="rowView" Height="Auto" MinHeight="280"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Module header + Apply Template -->
            <DockPanel Grid.Row="0" Margin="16,14,16,6" LastChildFill="True">
                <StackPanel x:Name="pnlApplyTemplate" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Apply Template:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cboApplyTemplate" Width="220" Height="26" FontSize="12" VerticalContentAlignment="Center" ToolTip="Select a saved template to fill the form with its settings."/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="txtModuleHeader" Text="Apps Deployment" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModuleSubheader"
                               Text="Select an application and a device collection, then configure the deployment."
                               FontSize="12"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Unified form pane. Scrollable fields + fixed action button row. -->
            <Grid Grid.Row="1" x:Name="formPane" Margin="16,6,16,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">

                    <!-- Shared form fields (visible for all types) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target name (label changes per type) -->
                        <TextBlock x:Name="lblTargetName" Grid.Row="0" Grid.Column="0" Text="Application:" Style="{StaticResource FormLabelStyle}" Margin="0,8,12,8"/>
                        <TextBox x:Name="txtTargetName" Grid.Row="0" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,8,0,8"
                                 Controls:TextBoxHelper.Watermark="For example, 7-Zip 26.00" ToolTip="Enter the name of the object to deploy, or select Browse to pick it from the site."/>
                        <Button x:Name="btnBrowseTarget" Grid.Row="0" Grid.Column="2" Content="Browse..." Style="{StaticResource InlineButtonStyle}" Margin="8,8,0,8"
                                ToolTip="Pick the object from the site."/>

                        <!-- Program (Packages type only) -->
                        <TextBlock x:Name="lblProgram" Grid.Row="1" Grid.Column="0" Text="Program:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <ComboBox  x:Name="cboProgram" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                   Visibility="Collapsed" ToolTip="Select the program of the package to deploy."/>

                        <!-- Collection -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Collection:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <TextBox x:Name="txtCollection" Grid.Row="2" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 Controls:TextBoxHelper.Watermark="Device collection name, for example Workstations - Pilot" ToolTip="Enter the name of the device collection that receives the deployment."/>
                        <Button x:Name="btnBrowseCollection" Grid.Row="2" Grid.Column="2" Content="Browse..." Style="{StaticResource InlineButtonStyle}" Margin="8,0,0,8"
                                ToolTip="Pick a device collection from the site."/>

                        <!-- Purpose -->
                        <TextBlock x:Name="lblPurpose" Grid.Row="3" Grid.Column="0" Text="Purpose:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="radAvailable" Content="Available" GroupName="Purpose" IsChecked="True" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Make the content available for users to install, with no deadline."/>
                            <RadioButton x:Name="radRequired"  Content="Required"  GroupName="Purpose" FontSize="12" VerticalAlignment="Center" ToolTip="Install the content on the devices when the deadline passes."/>
                        </StackPanel>

                        <!-- Available datetime -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Available:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <Controls:DateTimePicker x:Name="dtpAvailable" Grid.Row="4" Grid.Column="1" Width="240" HorizontalAlignment="Left"
                                                 FontSize="12" Height="26" Margin="0,0,0,8" ToolTip="Select the date and time when the deployment becomes available."/>

                        <!-- Deadline datetime (only when Required) -->
                        <TextBlock x:Name="lblDeadline" Grid.Row="5" Grid.Column="0" Text="Deadline:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <Controls:DateTimePicker x:Name="dtpDeadline" Grid.Row="5" Grid.Column="1" Width="240" HorizontalAlignment="Left"
                                                 FontSize="12" Height="26" Visibility="Collapsed" Margin="0,0,0,8" ToolTip="Select the date and time when the required deployment installs on the devices."/>

                        <!-- Notification (Apps type only; packages don't use UserNotification) -->
                        <TextBlock x:Name="lblNotification" Grid.Row="6" Grid.Column="0" Text="Notification:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <ComboBox x:Name="cboNotification" Grid.Row="6" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                  FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Select what users see about the deployment, or where a task sequence is available.">
                            <ComboBoxItem Content="Display All" IsSelected="True" Tag="DisplayAll"/>
                            <ComboBoxItem Content="Display in Software Center Only" Tag="DisplaySoftwareCenterOnly"/>
                            <ComboBoxItem Content="Hide All" Tag="HideAll"/>
                        </ComboBox>

                        <!-- Time basis -->
                        <TextBlock x:Name="lblTimeBasis" Grid.Row="7" Grid.Column="0" Text="Time Basis:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="radLocalTime" Content="Local time" GroupName="TimeBasis" IsChecked="True" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Use the local time of each device for the available time and the deadline."/>
                            <RadioButton x:Name="radUtc"       Content="UTC"        GroupName="TimeBasis" FontSize="12" VerticalAlignment="Center" ToolTip="Use UTC for the available time and the deadline, so every device acts at the same moment."/>
                        </StackPanel>

                        <!-- Distribute content (Apps/Packages/TS only; SUG distributes via SUDP separately) -->
                        <TextBlock x:Name="lblDistribute" Grid.Row="8" Grid.Column="0" Text="Distribute To:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <StackPanel x:Name="pnlDistribute" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <Button x:Name="btnDPPicker" Content="Select DP Groups..." MinWidth="220" HorizontalContentAlignment="Left" Padding="10,0,10,0"
                                    Style="{StaticResource InlineButtonStyle}"
                                    ToolTip="Pick the distribution point groups for the content."/>
                            <Button x:Name="btnDistributeContent" Content="Distribute Content" MinWidth="140" Margin="8,0,0,0"
                                    Style="{StaticResource InlineButtonStyle}"
                                    ToolTip="Distribute the content to the selected distribution point groups."/>
                        </StackPanel>

                        <!-- Required-only: override service window + reboot outside -->
                        <StackPanel x:Name="pnlRequiredOptions" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,8" Visibility="Collapsed">
                            <CheckBox x:Name="chkOverrideSW"   Content="Override maintenance window"    FontSize="12" Margin="0,0,0,4" ToolTip="Allow the deployment to run outside the maintenance windows of the collection."/>
                            <CheckBox x:Name="chkRebootOutSW"  Content="Allow restart outside maintenance window" FontSize="12" Margin="0,0,0,4" ToolTip="Allow a restart that the deployment needs to happen outside the maintenance windows."/>
                            <CheckBox x:Name="chkMetered"      Content="Allow download on metered network" FontSize="12" Margin="0,0,0,0" ToolTip="Allow devices on a metered network to download the content."/>
                        </StackPanel>

                        <!-- Packages-only checkboxes; the network and rerun rows are rows 10-12. -->
                        <StackPanel x:Name="pnlPackageOptions" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,8" Visibility="Collapsed">
                            <CheckBox x:Name="chkPkgOverrideSW"   Content="Override maintenance window"             FontSize="12" Margin="0,0,0,4" ToolTip="Allow the deployment to run outside the maintenance windows of the collection."/>
                            <CheckBox x:Name="chkPkgRebootOutSW"  Content="Allow restart outside maintenance window" FontSize="12" Margin="0,0,0,4" ToolTip="Allow a restart that the deployment needs to happen outside the maintenance windows."/>
                            <CheckBox x:Name="chkPkgMetered"      Content="Allow download on metered network"       FontSize="12" Margin="0,0,0,0" ToolTip="Allow devices on a metered network to download the content."/>
                        </StackPanel>

                        <TextBlock x:Name="lblPkgFastNetwork" Grid.Row="10" Grid.Column="0" Text="Fast Network:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <ComboBox  x:Name="cboPkgFastNetwork" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Select how a device on a fast network runs the program.">
                            <ComboBoxItem Tag="DownloadContentFromDistributionPointAndRunLocally" Content="Download content from distribution point and run locally" IsSelected="True"/>
                            <ComboBoxItem Tag="RunProgramFromDistributionPoint"                    Content="Run program from distribution point"/>
                        </ComboBox>
                        <TextBlock x:Name="lblPkgSlowNetwork" Grid.Row="11" Grid.Column="0" Text="Slow Network:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <ComboBox  x:Name="cboPkgSlowNetwork" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Select how a device on a slow network runs the program, or whether it runs at all.">
                            <ComboBoxItem Tag="DoNotRunProgram"                                 Content="Do not run program" IsSelected="True"/>
                            <ComboBoxItem Tag="DownloadContentFromDistributionPointAndLocally"  Content="Download content from distribution point and run locally"/>
                            <ComboBoxItem Tag="RunProgramFromDistributionPoint"                 Content="Run program from distribution point"/>
                        </ComboBox>
                        <TextBlock x:Name="lblPkgRerun" Grid.Row="12" Grid.Column="0" Text="Rerun Behavior:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <ComboBox  x:Name="cboPkgRerun" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Select when the program runs again on a device that already ran it.">
                            <ComboBoxItem Tag="NeverRerunDeployedProgram"         Content="Never rerun deployed program" IsSelected="True"/>
                            <ComboBoxItem Tag="AlwaysRerunProgram"                Content="Always rerun program"/>
                            <ComboBoxItem Tag="RerunIfFailedPreviousAttempt"      Content="Rerun if failed previous attempt"/>
                            <ComboBoxItem Tag="RerunIfSucceededOnPreviousAttempt" Content="Rerun if succeeded on previous attempt"/>
                        </ComboBox>

                        <!-- Task Sequence-only options -->
                        <StackPanel x:Name="pnlTaskSequenceOptions" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,8" Visibility="Collapsed">
                            <CheckBox x:Name="chkTsOverrideSW"   Content="Override maintenance window" FontSize="12" Margin="0,0,0,4" ToolTip="Allow the deployment to run outside the maintenance windows of the collection."/>
                            <CheckBox x:Name="chkTsRebootOutSW"  Content="Allow restart outside maintenance window"         FontSize="12" Margin="0,0,0,4" ToolTip="Allow a restart that the deployment needs to happen outside the maintenance windows."/>
                            <CheckBox x:Name="chkTsMetered"      Content="Allow download on metered network" FontSize="12" Margin="0,0,0,4" ToolTip="Allow devices on a metered network to download the content."/>
                            <CheckBox x:Name="chkShowProgress"   Content="Show task sequence progress on client" FontSize="12" Margin="0,0,0,0" IsChecked="True" ToolTip="Show the task sequence progress to the user on the device."/>
                        </StackPanel>

                        <!-- SUG-only options -->
                        <StackPanel x:Name="pnlSUGOptions" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,8" Visibility="Collapsed">
                            <CheckBox x:Name="chkSugOverrideSW"   Content="Override maintenance window" FontSize="12" Margin="0,0,0,4" ToolTip="Allow the deployment to run outside the maintenance windows of the collection."/>
                            <CheckBox x:Name="chkSugAllowRestart" Content="Allow restart outside maintenance window"         FontSize="12" Margin="0,0,0,4" ToolTip="Allow a restart that the deployment needs to happen outside the maintenance windows."/>
                            <CheckBox x:Name="chkSugMetered"      Content="Allow download on metered network" FontSize="12" Margin="0,0,0,4" ToolTip="Allow devices on a metered network to download the content."/>
                            <CheckBox x:Name="chkMSFallback"       Content="Fall back to Microsoft Update if no distribution point has content" FontSize="12" Margin="0,0,0,4" ToolTip="Let devices get the updates from Microsoft Update when no distribution point has them."/>
                            <CheckBox x:Name="chkBoundaryFallback" Content="Allow fallback to neighbor boundary groups" FontSize="12" Margin="0,0,0,4" IsChecked="True" ToolTip="Let devices use a neighbor boundary group when their own group has no content."/>
                            <CheckBox x:Name="chkFullScan"         Content="Require post-reboot full scan" FontSize="12" Margin="0,0,0,0" IsChecked="True" ToolTip="Run a full software updates scan on the device after the restart that the updates need."/>
                        </StackPanel>
                    </Grid>

                    <!-- Validation panel -->
                    <TextBlock Text="Validation" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6"/>
                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="0,1,0,1" Padding="8,10,8,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="glyphCheck1" Text="&#x22EF;" Style="{StaticResource CheckGlyphStyle}"/>
                                <TextBlock x:Name="lblCheck1"   Text="Application exists in Configuration Manager" Style="{StaticResource CheckLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="glyphCheck2" Text="&#x22EF;" Style="{StaticResource CheckGlyphStyle}"/>
                                <TextBlock x:Name="lblCheck2"   Text="Content distributed to DPs"             Style="{StaticResource CheckLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="glyphCheck3" Text="&#x22EF;" Style="{StaticResource CheckGlyphStyle}"/>
                                <TextBlock x:Name="lblCheck3"   Text="Collection valid (device, not user)"    Style="{StaticResource CheckLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="glyphCheck4" Text="&#x22EF;" Style="{StaticResource CheckGlyphStyle}"/>
                                <TextBlock x:Name="lblCheck4"   Text="Collection safe (not built-in SMS*)"    Style="{StaticResource CheckLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="glyphCheck5" Text="&#x22EF;" Style="{StaticResource CheckGlyphStyle}"/>
                                <TextBlock x:Name="lblCheck5"   Text="No duplicate deployment"                Style="{StaticResource CheckLabelStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <!-- Action buttons (fixed at bottom, outside scrollviewer) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,4">
                    <Button x:Name="btnValidate" Content="Validate" MinWidth="110" Margin="0,0,8,0"
                            Style="{StaticResource DialogButton}"
                            ToolTip="Run the five checks for the deployment."/>
                    <Button x:Name="btnDeploy"   Content="Deploy"   MinWidth="110" Visibility="Collapsed"
                            Style="{StaticResource DialogAccentButton}"
                            ToolTip="Create the deployment on the site."/>
                </StackPanel>
            </Grid>

            <!-- Ring deployment pane: shares Grid.Row 1 with formPane; one of the two is visible. -->
            <Grid Grid.Row="1" x:Name="ringPane" Margin="16,6,16,6" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- The two grids share the free height (star rows); the view scrolls when the window is smaller than the minimum rows. -->
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Object Type:" Style="{StaticResource FormLabelStyle}" Margin="0,8,12,8"/>
                        <ComboBox x:Name="cboRingType" Grid.Row="0" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                  FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,8,0,8" ToolTip="Select the type of object to deploy in rings.">
                            <ComboBoxItem Content="Application" Tag="Application" IsSelected="True"/>
                            <ComboBoxItem Content="Package" Tag="Package"/>
                            <ComboBoxItem Content="Task sequence" Tag="TaskSequence"/>
                            <ComboBoxItem Content="Software update group" Tag="SUG"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Object:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <TextBox x:Name="txtRingObject" Grid.Row="1" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 Controls:TextBoxHelper.Watermark="Name of the application, package, task sequence, or software update group" ToolTip="Enter the name of the object to deploy in rings, or select Browse to pick it from the site."/>
                        <Button x:Name="btnRingBrowseObject" Grid.Row="1" Grid.Column="2" Content="Browse..." Style="{StaticResource InlineButtonStyle}" Margin="8,0,0,8"
                                ToolTip="Pick the object from the site."/>

                        <TextBlock x:Name="lblRingProgram" Grid.Row="2" Grid.Column="0" Text="Program:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8" Visibility="Collapsed"/>
                        <ComboBox x:Name="cboRingProgram" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Height="26"
                                  VerticalContentAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Select the program of the package to deploy in rings."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ring Plan:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <ComboBox x:Name="cboRingPlan" Grid.Row="3" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Select the ring plan that sets the rings, their collections, timing and thresholds."/>
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,8">
                            <Button x:Name="btnRingReloadPlans" Content="Reload" Style="{StaticResource InlineButtonStyle}" Margin="0,0,8,0"
                                    ToolTip="Reload the ring plan files."/>
                            <Button x:Name="btnRingOpenFolder" Content="Open Folder" Style="{StaticResource InlineButtonStyle}" Margin="0"
                                    ToolTip="Open the folder that holds the ring plan files."/>
                        </StackPanel>

                        <TextBlock x:Name="lblRingStart" Grid.Row="4" Grid.Column="0" Text="Plan Start:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,8"/>
                        <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Controls:DateTimePicker x:Name="dtpRingStart" Width="240" FontSize="12" Height="26" ToolTip="Select the plan start date and time that the ring dates count from."/>
                            <Button x:Name="btnRingExpand" Content="Expand" MinWidth="90" Margin="8,0,0,0"
                                    Style="{StaticResource InlineButtonStyle}"
                                    ToolTip="Calculate the dates of every ring from the plan start."/>
                            <CheckBox x:Name="chkRingHold" Content="Hold later rings (create ring 1 now, promote the rest)" FontSize="12"
                                      VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Create only ring 1 now and promote the later rings from the Open Runs list."/>
                        </WrapPanel>

                        <TextBlock x:Name="txtRingPlanInfo" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}" Margin="0,0,0,4"/>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,10,0,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Expansion Preview" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"
                                   ToolTip="Edits in the preview apply to this run only."/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnRingPickCollection" Content="Set Collection..." MinWidth="120" Margin="0,0,8,0"
                                    Style="{StaticResource DialogButton}"
                                    ToolTip="Pick the device collection for the selected ring (hold Shift to reload the list)."/>
                            <Button x:Name="btnRingValidate" Content="Validate" MinWidth="110" Margin="0,0,8,0"
                                    Style="{StaticResource DialogButton}"
                                    ToolTip="Run the five checks for every ring."/>
                            <Button x:Name="btnRingCreate" Content="Create Deployments" MinWidth="150" Visibility="Collapsed"
                                    Style="{StaticResource DialogAccentButton}"
                                    ToolTip="Create the ring deployments on the site."/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="dgRingPreview" Grid.Row="2" Style="{StaticResource ViewDataGrid}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowStyle="{StaticResource GridRowStyle}" CellStyle="{StaticResource GridCellStyle}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="32"/>
                            <DataGridTextColumn Header="Ring" Binding="{Binding Name}" IsReadOnly="True" Width="96"/>
                            <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionID, Mode=TwoWay}" Width="118"/>
                            <DataGridTextColumn Header="Collection" Binding="{Binding CollectionName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" IsReadOnly="True" Width="86"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding AvailableText, Mode=TwoWay}" Width="120"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText, Mode=TwoWay}" Width="120"/>
                            <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdText}" IsReadOnly="True" Width="96"/>
                            <DataGridTextColumn Header="Checks" Binding="{Binding Checks}" IsReadOnly="True" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Checks}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="3" Margin="0,14,0,6" LastChildFill="False">
                        <TextBlock x:Name="lblRingRuns" DockPanel.Dock="Left" Text="Open Runs" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                        <Button x:Name="btnRingRefreshRuns" DockPanel.Dock="Right" Content="Refresh and Reconcile" MinWidth="150" Margin="0"
                                Style="{StaticResource InlineButtonStyle}"
                                ToolTip="Get the live counts from the site, mark deleted deployments Removed and close finished runs."/>
                        <CheckBox x:Name="chkRingShowClosed" DockPanel.Dock="Right" Content="Show closed runs" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="List the closed runs, which are not read from the site again, instead of the open runs."/>
                    </DockPanel>
                    <DataGrid x:Name="dgRingRuns" Grid.Row="4" Style="{StaticResource ViewDataGrid}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowStyle="{StaticResource GridRowStyle}" CellStyle="{StaticResource GridCellStyle}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run" Binding="{Binding RunLabel}" Width="3*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding RunLabel}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32"/>
                            <DataGridTextColumn Header="Ring" Binding="{Binding Name}" Width="90"/>
                            <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionID}" Width="118"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineText}" Width="115"/>
                            <DataGridTextColumn Header="Targeted" Binding="{Binding Targeted}" Width="90"/>
                            <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="82"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Errors}" Width="66"/>
                            <DataGridTextColumn Header="In Progress" Binding="{Binding InProgress}" Width="110"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Note}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Promote" Height="20" MinWidth="70" Margin="2" Padding="8,0,8,0"
                                                IsEnabled="{Binding CanPromote}"
                                                ToolTip="{Binding PromoteTip}" ToolTipService.ShowOnDisabled="True">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DialogAccentButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowPromote}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Update rollout pane: shares Grid.Row 1 with formPane and ringPane; one of the three is visible. -->
            <Grid Grid.Row="1" x:Name="rolloutPane" Margin="16,6,16,6" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="130"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,4,0,6" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Applications" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"
                                   ToolTip="One row for each application to update, with its new version, software name and role."/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnRoAdd" Content="Add Applications..." MinWidth="140" Margin="0,0,8,0" Style="{StaticResource DialogButton}"
                                    ToolTip="Pick applications that are published in the site."/>
                            <Button x:Name="btnRoImport" Content="Import List..." MinWidth="110" Margin="0,0,8,0" Style="{StaticResource DialogButton}"
                                    ToolTip="Paste a list or read a CSV file with the applications and their new versions."/>
                            <Button x:Name="btnRoLookup" Content="Look Up Names" MinWidth="120" Margin="0,0,8,0" Style="{StaticResource DialogButton}"
                                    ToolTip="Look up the installed-software name of the selected rows in the inventory."/>
                            <Button x:Name="btnRoRemove" Content="Remove" MinWidth="90" Margin="0" Style="{StaticResource DialogButton}"
                                    ToolTip="Remove the selected rows from the list."/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="dgRoRows" Grid.Row="1" Style="{StaticResource ViewDataGrid}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowStyle="{StaticResource GridRowStyle}" CellStyle="{StaticResource GridCellStyle}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding Application, Mode=TwoWay}" Width="2*" MinWidth="90"/>
                            <DataGridTextColumn Header="Site Version" Binding="{Binding CurrentVersion}" IsReadOnly="True" Width="104"/>
                            <DataGridTextColumn Header="New Version" Binding="{Binding NewVersion, Mode=TwoWay}" Width="108"/>
                            <DataGridTextColumn Header="Installed Software Name" Binding="{Binding SoftwareName, Mode=TwoWay}" Width="2*" MinWidth="90"/>
                            <DataGridComboBoxColumn x:Name="colRoRole" Header="Role" SelectedItemBinding="{Binding Role, Mode=TwoWay}" Width="92"/>
                            <DataGridTextColumn Header="Test Collection" Binding="{Binding TestCollection, Mode=TwoWay}" Width="*" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"
                                   ToolTip="Set the name template, the limiting collections, the folder and the deployment times."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name Template:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,6"/>
                            <TextBox x:Name="txtRoTemplate" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,6"
                                     ToolTip="Sets the collection name, with {App}, {Role} and {Version} as placeholders."/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Folder:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,6"/>
                            <TextBox x:Name="txtRoFolder" Grid.Row="0" Grid.Column="5" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,6"
                                     Controls:TextBoxHelper.Watermark="Optional"
                                     ToolTip="Sets the console folder of new collections, below Device Collections; empty means the root."/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Server Limit:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,6"/>
                            <TextBox x:Name="txtRoLimitServer" Grid.Row="1" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,6"
                                     ToolTip="Sets the limiting collection of the Server collections, by name or by ID."/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Workstation Limit:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,6"/>
                            <TextBox x:Name="txtRoLimitWorkstation" Grid.Row="1" Grid.Column="3" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,6"
                                     ToolTip="Sets the limiting collection of the Workstation collections, by name or by ID."/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Test Limit:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,6"/>
                            <TextBox x:Name="txtRoLimitTest" Grid.Row="1" Grid.Column="5" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,6"
                                     ToolTip="Sets the limiting collection of a test collection that the rollout creates, by name or ID."/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Test Collection:" Style="{StaticResource FormLabelStyle}" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtRoTestCollection" Grid.Row="2" Grid.Column="1" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                     Controls:TextBoxHelper.Watermark="Existing collection"
                                     ToolTip="Sets an existing test collection for every row; empty creates one from the template."/>
                            <WrapPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Refresh days:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtRoRefresh" Width="40" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         ToolTip="Sets the days between membership updates of a new collection; 0 means manual updates."/>
                                <TextBlock Text="Available in (h):" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtRoDelay" Width="40" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         ToolTip="Sets the hours from the start of a step until the deployment is available."/>
                                <TextBlock Text="Test deadline (h):" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtRoTestDeadline" Width="40" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         ToolTip="Sets the hours from the available time to the deadline of the test deployment (1 or more)."/>
                                <TextBlock Text="Production deadline (h):" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtRoProdDeadline" Width="40" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         ToolTip="Sets the hours from the available time to the deadline of the production deployment (1 or more)."/>
                                <TextBlock Text="Notification:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboRoNotification" Width="210" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0"
                                          ToolTip="Select what the user sees when the deployment is available.">
                                    <ComboBoxItem Content="Display all" Tag="DisplayAll"/>
                                    <ComboBoxItem Content="Software Center only" Tag="DisplaySoftwareCenterOnly"/>
                                    <ComboBoxItem Content="Hide all" Tag="HideAll"/>
                                </ComboBox>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>

                    <WrapPanel Grid.Row="3" Margin="0,10,0,6" Orientation="Horizontal">
                        <TextBlock x:Name="txtRoRunInfo" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,0,16,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <CheckBox x:Name="chkRoDryRun" Content="Dry run" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="Show what a step would do; nothing is created and nothing is written to the audit log."/>
                            <ComboBox x:Name="cboRoRuns" Width="230" FontSize="12" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="Select a saved run; a run keeps the plan between Step 1 and Step 2."/>
                            <Button x:Name="btnRoOpenRun" Content="Open Run" MinWidth="90" Margin="0,0,8,0" Style="{StaticResource DialogButton}"
                                    ToolTip="Load the selected saved run to continue with Step 2."/>
                            <Button x:Name="btnRoPreview" Content="Preview Plan" MinWidth="110" Margin="0,0,8,0" Style="{StaticResource DialogButton}"
                                    ToolTip="Run the checks and count the members of every query; nothing is created."/>
                            <Button x:Name="btnRoStep1" Content="Step 1: Deploy to Test" MinWidth="160" Margin="0,0,8,0" Visibility="Collapsed" Style="{StaticResource DialogAccentButton}"
                                    ToolTip="Create the test collections and deploy the new versions to the test targets."/>
                            <Button x:Name="btnRoStep2" Content="Step 2: Create Production" MinWidth="170" Margin="0" Visibility="Collapsed" Style="{StaticResource DialogAccentButton}"
                                    ToolTip="Create the production collections and deploy the new versions to them."/>
                    </WrapPanel>

                    <DataGrid x:Name="dgRoPlan" Grid.Row="4" Style="{StaticResource ViewDataGrid}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowStyle="{StaticResource GridRowStyle}" CellStyle="{StaticResource GridCellStyle}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32"/>
                            <DataGridTextColumn Header="Step" Binding="{Binding Stage}" Width="60"/>
                            <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="*" MinWidth="70"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="Collection" Binding="{Binding CollectionName}" Width="2*" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding CollectionName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="88"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="76"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="2*" MinWidth="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Message}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Resizable splitter -->
            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <!-- Log output drawer -->
            <Border Grid.Row="3">
                <DockPanel>
                    <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Top" Text="Log Output"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="8,6,0,4"/>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="4" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready."/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>
